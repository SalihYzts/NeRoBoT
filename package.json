{
  "name": "nerobot",
  "version": "4.4.24",
  "description": "",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "gen-icons": "node scripts/gen-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "build": "node scripts/build.js",
    "release": "node scripts/release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.0",
    "ollama": "^0.6.3",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "teleproto": "^1.228.3",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.nerobot.app",
    "productName": "NeRoBoT",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "app/**/*",
      "src/**/*",
      "ascii.txt",
      "package.json",
      "help.txt"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeRoBoT",
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "publish": {
      "provider": "github",
      "owner": "SalihYzts",
      "repo": "NeRoBoT",
      "releaseType": "release"
    }
  }
}
