# Maintainer: Salih Yazıtaş
# GitHub Release'deki .AppImage'i indirip gerçek bir pacman paketine
# (menü girişi + ikon + fuse2 bağımlılığı dahil) çeviren "-bin" tarzı paket.
# Yeni bir sürüm çıktığında pkgver'i güncelleyip "updpkgsums" çalıştırman
# yeterli (bkz. NeRoBoT_Yayinla.sh/scripts/release.js — o yeni sürümü
# GitHub Release olarak yayınlıyor, bu PKGBUILD ondan indiriyor).
pkgname=nerobot
pkgver=4.4.26
pkgrel=1
pkgdesc="NeRoBoT masaüstü uygulaması"
arch=('x86_64')
url="https://github.com/SalihYzts/NeRoBoT"
license=('ISC')
depends=('fuse2' 'gtk3' 'nss' 'alsa-lib' 'libxss' 'libnotify' 'libxtst')
options=('!strip')
source=("https://github.com/SalihYzts/NeRoBoT/releases/download/v${pkgver}/NeRoBoT-${pkgver}.AppImage"
        "nerobot.desktop"
        "nerobot.png")
sha256sums=('150c3cfaee9aff97b0cf5b191bbe359e7bd26501c3f4ace429136a48aa2ce492'
            '7208ea73d3b304af1f301ec8138e30734dcdc0efff48c33b9e71e884cc58eb7c'
            'afc914406a601cba70724975eef5fcd8b9efb7f6e2f885b677f69fc64a5baadb')
noextract=("NeRoBoT-${pkgver}.AppImage")

package() {
    install -Dm755 "${srcdir}/NeRoBoT-${pkgver}.AppImage" "${pkgdir}/opt/nerobot/nerobot.AppImage"
    install -Dm644 "${srcdir}/nerobot.desktop" "${pkgdir}/usr/share/applications/nerobot.desktop"
    install -Dm644 "${srcdir}/nerobot.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/nerobot.png"

    install -d "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/nerobot" <<'EOF'
#!/usr/bin/env bash
exec /opt/nerobot/nerobot.AppImage "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/nerobot"
}
